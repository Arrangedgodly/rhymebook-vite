rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Cross-service read: requires the "Firebase Rules Firestore Service
    // Agent" IAM role granted to Storage's service agent. In practice this
    // grant repeatedly failed to take effect for this project (tried three
    // times, including via the CLI's own prompt) -- still used for read
    // below, but no longer load-bearing for write; see the match block.
    function noteDoc(noteId) {
      return firestore.get(/databases/(default)/documents/notes/$(noteId)).data;
    }

    function canAccessNote(noteId) {
      return request.auth != null
        && (request.auth.uid == noteDoc(noteId).userId
            || request.auth.uid in noteDoc(noteId).get('sharedWith', []));
    }

    // Sync audio for a note. The uploader's own uid is embedded directly in
    // the object path, so write access is a plain path/auth match -- it
    // never depends on the Firestore cross-service read that proved
    // unreliable here. This means only a note's owner can attach/replace its
    // audio for now (not a collaborator); read still uses the
    // owner-or-collaborator Firestore check, since a collaborator should
    // still be able to play back audio someone else attached -- if that
    // read also turns out to be unreliable, it needs the same fix, but
    // that's not a currently-confirmed problem, only write was.
    match /notes/{noteId}/sync/{syncId}/audio/{uid}/{fileName} {
      allow read: if canAccessNote(noteId);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
